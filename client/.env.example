# =========================================================
# CONFIGURAÇÕES DO SUPABASE (FRONTEND VITE)
# =========================================================
# Copie este arquivo para .env ou preencha diretamente na plataforma em "Conexões & WAHA"
# No painel do Supabase (https://supabase.com/dashboard/project/_/settings/api):
# 1. Project URL -> cole em VITE_SUPABASE_URL
# 2. Project API Keys -> anon / public -> cole em VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
