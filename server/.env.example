# =========================================================
# CONFIGURAÇÕES DO SERVIDOR (BACKEND NODE.JS)
# =========================================================
PORT=3001

# =========================================================
# SUPABASE (https://supabase.com/dashboard/project/_/settings/api)
# =========================================================
SUPABASE_URL=https://seu-projeto.supabase.co
# service_role key (admin) ou anon_key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-ou-anon-key-aqui

# =========================================================
# WAHA WHATSAPP HTTP API (Docker ou VPS)
# =========================================================
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=

# =========================================================
# 1. CASCATA DE TEXTO & VENDAS 100% NVIDIA NIM (https://build.nvidia.com)
# =========================================================
# Todos os modelos de texto e negociação rodam na infraestrutura ultra-rápida da NVIDIA.
# Basta colocar sua chave em NVIDIA_API_KEY.
# Se tiver várias contas/chaves da NVIDIA, cole separadas por vírgula em NVIDIA_API_KEYS (rotação anti-rate-limit 429).
NVIDIA_API_KEY=nvapi-sua-chave-nvidia-aqui
NVIDIA_API_KEYS=

# Modelos da Cascata NVIDIA (ordenados por prioridade automática):
# 1º: meta/llama-3.3-70b-instruct (Vendas X1, SPIN Selling e fechamento)
# 2º: deepseek-ai/deepseek-r1 (Raciocínio profundo e quebra de objeções)
# 3º: nvidia/llama-3.1-nemotron-70b-instruct (Otimizado da NVIDIA)
# 4º: meta/llama-3.1-405b-instruct (Super modelo de 405B parâmetros)
# 5º: meta/llama-3.1-8b-instruct (Backup ultra veloz)

# =========================================================
# 2. VOZ & ÁUDIO PTT WHATSAPP (FISH AUDIO DIRETO / OPENROUTER)
# =========================================================
# OPÇÃO A: API DIRETA DO FISH AUDIO (Recomendado para escolher voz personalizada ou clonada)
# Cadastre-se e pegue sua chave em: https://fish.audio/app/api-keys
# Escolha vozes da biblioteca em: https://fish.audio/discovery
FISH_AUDIO_API_KEY=
# Cole aqui o ID da voz escolhida no fish.audio (ou ID da sua voz clonada):
FISH_AUDIO_VOICE_ID=

# OPÇÃO B: OPENROUTER (Voz padrão gratuita)
# Chave em: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-sua-chave-openrouter-aqui
VOICE_MODEL=fish-audio/s2.1-pro-free:free

# OPÇÃO C: OPENAI TTS (Vozes Nova, Shimmer, Onyx, Alloy, Echo)
OPENAI_API_KEY=

# =========================================================
# 3. IA ARQUITETA DO SISTEMA (CRIAÇÃO & MANUTENÇÃO DE FUNIS)
# =========================================================
# Modelo de inteligência profunda para arquitetura, criação e manutenção de funis
SYSTEM_ARCHITECT_MODEL=z-ai/glm-5.3
OPENROUTER_MODEL=z-ai/glm-5.3

